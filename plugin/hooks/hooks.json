{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true },
          { "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" --no-wait onboard.js", "timeout": 5 }
        ]
      }
    ],
    "UserPromptSubmit": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PreToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PermissionRequest": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PermissionDenied": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PostToolUse": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PostToolUseFailure": [
      { "matcher": "*", "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "Notification": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "Elicitation": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "ElicitationResult": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "SubagentStart": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "SubagentStop": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "Stop": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "StopFailure": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PreCompact": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "PostCompact": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ],
    "SessionEnd": [
      { "hooks": [{ "type": "command", "command": "sh \"${CLAUDE_PLUGIN_ROOT}/bin/miblo-run\" hook.js", "async": true }] }
    ]
  }
}
